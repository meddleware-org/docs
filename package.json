{
  "name": "@meddleware/docs",
  "version": "0.0.29",
  "description": "Meddleware developer tools documentation site (docs.meddleware.co.uk) — VitePress. Blockchain-agnostic with Sui as the first active chain.",
  "homepage": "https://docs.meddleware.co.uk/",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/docs.git"
  },
  "type": "module",
  "files": [
    "docs",
    "scripts",
    "tsconfig.json",
    "tsconfig.typedoc.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen:onchain": "node scripts/gen-onchain.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "dev": "npm run gen:api && npm run gen:onchain && vitepress dev docs",
    "build": "npm run gen:api && npm run gen:onchain && vitepress build docs",
    "preview": "vitepress preview docs",
    "type-check": "tsc --noEmit",
    "lint:css": "stylelint \"docs/.vitepress/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"docs/.vitepress/**/*.vue\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.8",
    "@meddleware/design-tokens": "^0.1.9",
    "@meddleware/seal-client": "^0.0.19",
    "@meddleware/ui": "^0.1.31"
  },
  "devDependencies": {
    "@meddleware/access-gate-sui": "^0.0.6",
    "@meddleware/nft-gate-client": "^0.0.16",
    "@meddleware/seal-policies-sui": "^0.0.7",
    "@meddleware/sui-token-template": "^1.0.8",
    "@meddleware/walrus-client": "^0.0.26",
    "@mysten/seal": "^1.4.17",
    "@mysten/sui": "^2.33.1",
    "@mysten/walrus": "~1.2.32",
    "@types/node": "~24.12.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.0",
    "typescript": "~6.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
