{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": []
  },
  "//": "Used only by scripts/gen-api.mjs (TypeDoc). Includes the installed SDK sources so the TS program has inputs; TypeDoc's entryPoints then select what is documented.",
  "include": [
    "node_modules/@meddleware/sealed-storage-client/src",
    "node_modules/@meddleware/walrus-storage-client/src",
    "node_modules/@meddleware/access-gate-gateway-client/src",
    "node_modules/@meddleware/access-gate-client/src"
  ]
}
